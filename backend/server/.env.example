# ==========================================================
# ANAND TRAVEL TOURS - BACKEND ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=traveltours
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_super_secret_random_jwt_key_min_32_chars

# Payment Gateway - Razorpay (Optional)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email Notification Service (Optional)
# Option A: Standard SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="Anand Travel Tours <noreply@yourdomain.com>"

# Option B: Gmail (Alternative to SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_gmail_app_password
